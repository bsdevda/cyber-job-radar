{
  "http": {
    "timeout_seconds": 20,
    "retries": 2,
    "backoff_seconds": 1.0,
    "user_agent": "CyberJobRadar/1.0 (+personal non-commercial job search)"
  },
  "sources": {
    "arbeitnow": {
      "enabled": true,
      "endpoint": "https://www.arbeitnow.com/api/job-board-api",
      "max_pages": 8,
      "delay_seconds": 0.35
    },
    "remotive": {
      "enabled": true,
      "endpoint": "https://remotive.com/api/remote-jobs",
      "delay_seconds": 0.0
    },
    "greenhouse": {
      "enabled": true,
      "endpoint": "https://boards-api.greenhouse.io/v1/boards/{board}/jobs?content=true",
      "delay_seconds": 0.05,
      "max_workers": 8
    },
    "ashby": {
      "enabled": true,
      "endpoint": "https://api.ashbyhq.com/posting-api/job-board/{board}?includeCompensation=true",
      "delay_seconds": 0.05,
      "max_workers": 6
    },
    "lever": {
      "enabled": true,
      "endpoint": "https://api.lever.co/v0/postings/{site}?mode=json",
      "eu_endpoint": "https://api.eu.lever.co/v0/postings/{site}?mode=json",
      "delay_seconds": 0.05,
      "max_workers": 6
    },
    "personio": {
      "enabled": true,
      "endpoint": "https://{account}.jobs.personio.de/xml?language={language}",
      "delay_seconds": 0.05,
      "max_workers": 6
    }
  }
}
